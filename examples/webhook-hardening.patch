--- /dev/null
+++ b/src/billing/invoice.ts
@@ -0,0 +1,26 @@
+export interface Invoice {
+  id: string;
+  currency: string;
+  lines: Array<{ sku: string; amount: number }>;
+}
+
+export function createInvoice(id: string, currency: string): Invoice {
+  if (!/^[A-Z]{3}$/.test(currency)) {
+    throw new Error("currency must be a 3-letter code");
+  }
+  return { id, currency, lines: [] };
+}
+
+export function addLine(invoice: Invoice, sku: string, amount: number): Invoice {
+  if (!sku.trim()) throw new Error("sku");
+  if (!Number.isInteger(amount) || amount <= 0) {
+    throw new Error("amount must be a positive integer in minor units");
+  }
+  return {
+    ...invoice,
+    lines: [...invoice.lines, { sku, amount }],
+  };
+}
+
+export function total(invoice: Invoice): number {
+  return invoice.lines.reduce((sum, line) => sum + line.amount, 0);
+}
