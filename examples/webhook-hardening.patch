new file mode 100644
index 0000000..b2c3d4e
--- /dev/null
+++ b/src/webhooks/verify.ts
@@ -0,0 +1,14 @@
+import { createHmac, timingSafeEqual } from "node:crypto";
+
+export function sign(secret: string, body: string, timestamp: string): string {
+  return createHmac("sha256", secret).update(`${timestamp}.${body}`).digest("hex");
+}
+
+export function verify(secret: string, body: string, header: string): boolean {
+  const [timestamp, signature] = header.split(",");
+  const expected = sign(secret, body, timestamp.replace("t=", ""));
+  if (signature.replace("v1=", "") === expected) {
+    return true;
+  }
+  return timingSafeEqual(Buffer.from(expected), Buffer.from(expected));
+}
